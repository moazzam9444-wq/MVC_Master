@model BookingPage
@{var owner=ViewData["BookingOwner"] is true;}
<section class="dash-panel reservations-panel" id="sqlBookings" data-kx-composed="true">
 <div class="reservations-heading"><div><p class="reservation-eyebrow">YOUR TIME ON THE PITCH</p><h2>@(owner?"Your field bookings":"Your reservations")</h2><p>1- or 2-hour sessions · 13:00–23:00 Amman (UTC+03:00) · Stripe sandbox payments only.</p></div><a class="dash-btn" href="@(owner?"#fields":"/Pages/Fields/fields.html")">@(owner?"Manage fields":"Book a field") ↗</a></div>
 <form id="sqlBookingFilters" class="reservations-tools"><label class="reservation-search">Search bookings<input type="search" name="Search" maxlength="120" value="@ViewData["BookingSearch"]" placeholder="Field, city or status" /></label><label>Show<select name="Period"><option value="all" selected="@(Model.Period=="all")">All bookings</option><option value="upcoming" selected="@(Model.Period=="upcoming")">Upcoming / in progress</option><option value="history" selected="@(Model.Period=="history")">History</option></select></label><button class="dash-btn secondary" type="submit">Apply</button></form>
 <p class="sql-booking-notice" role="status">@Model.Total booking(s). @(owner?"":"Confirmed reservations may be cancelled until 3 hours before start (Amman). After that, contact the field owner.")</p>
 <div class="table-wrap"><table class="dashboard-table records-table" data-no-pagination><thead><tr><th>Field</th>@if(owner){<th>Player</th>}<th>Session</th><th>Price</th><th>Status</th><th>Actions</th></tr></thead><tbody>
 @foreach(var booking in Model.Items){
  <tr data-booking-id="@booking.Id"><td data-label="Field"><a class="table-primary" href="/Pages/Fields/field-details.html?id=@booking.FieldId">@booking.FieldName ↗</a><small class="table-secondary">@booking.Area, @booking.City</small></td>
  @if(owner){<td data-label="Player">@booking.PlayerName</td>}
  <td data-label="Session"><strong>@booking.StartsAt.ToOffset(TimeSpan.FromHours(3)).ToString("dd MMM yyyy")</strong><small>@booking.StartsAt.ToOffset(TimeSpan.FromHours(3)).ToString("HH:mm")–@booking.EndsAt.ToOffset(TimeSpan.FromHours(3)).ToString("HH:mm") · @booking.DurationMinutes min</small></td>
  <td data-label="Price">@booking.Price.ToString("0.00") JOD<small>@booking.PaymentStatus @(booking.FinancialReview?"· Manual financial review":"")</small></td><td data-label="Status">@booking.Status @if(booking.Ended&&booking.Status=="Confirmed"){<small>Session ended</small>}</td><td data-label="Actions"><div class="row-actions"><button class="dash-btn secondary" data-booking-view="@booking.Id">View</button>
  @if(booking.PaymentUrl is not null){<a class="dash-btn" href="@booking.PaymentUrl">Review payment</a>}
  @if(booking.CanCancel){<button class="dash-btn secondary" data-booking-action="cancel" data-id="@booking.Id" data-version="@booking.Version">Cancel</button>}
  @if(booking.CanComplete){<button class="dash-btn secondary" data-booking-action="complete" data-id="@booking.Id" data-version="@booking.Version">Complete</button>}
  </div></td></tr>
 }
 </tbody></table></div>
 @if(Model.Total==0){<div class="reservations-empty"><h3>No bookings to show</h3><p>@(owner?"Reservations for your fields will appear here.":"Find your next pitch to reserve a session.")</p></div>}
 <nav class="kicks-table-pagination" aria-label="Booking pages">@if(Model.Page>1){<button data-booking-page="@(Model.Page-1)">Previous</button>}<span>Page @Model.Page of @Math.Max(1,(int)Math.Ceiling(Model.Total/(double)Model.PageSize))</span>@if(Model.Page*Model.PageSize<Model.Total){<button data-booking-page="@(Model.Page+1)">Next</button>}</nav>
</section>
