@model FieldPage
<section class="dash-panel" id="sqlFields">
 <div class="view-heading"><div><h2>My fields</h2><p>@Model.Total fields · Archived fields retain their history.</p></div><button class="dash-btn" data-field-add>Add field ↗</button></div>
 <p id="sqlFieldsStatus" role="status"></p>
 @if(Model.Total==0){<p class="empty-dashboard">No fields yet. Add your first pitch to KICKS.</p>}
 <div class="table-wrap"><table class="dashboard-table records-table" data-no-pagination><thead><tr><th>Field</th><th>Price / hour</th><th>Status</th><th>Actions</th></tr></thead><tbody>
 @foreach(var field in Model.Items){
 <tr><td data-label="Field"><a class="table-primary" href="/Pages/Fields/field-details.html?id=@field.Id">@field.Name ↗</a><small class="table-secondary">@field.Area, @field.City · @field.Type</small><img src="@field.Photo" alt="@field.Name" width="100" height="65" style="object-fit:cover;border-radius:6px" /></td><td data-label="Price / hour">@field.Price.ToString("0.00") JOD</td><td data-label="Status">@(field.IsArchived?"Archived":"Published")</td><td data-label="Actions"><div class="row-actions">
 @if(!field.IsArchived){<button class="dash-btn secondary" data-field-edit="@field.Id">Edit</button>}
 <button class="dash-btn secondary" data-field-state="@field.Id" data-archived="@field.IsArchived.ToString().ToLowerInvariant()" data-version="@field.Version">@(field.IsArchived?"Restore":"Archive")</button></div></td></tr>
 }
 </tbody></table></div>
 <nav class="kicks-table-pagination" aria-label="My fields pages">
 @if(Model.Page>1){<button data-field-page="@(Model.Page-1)">Previous</button>}
 <span>Page @Model.Page of @Math.Max(1,(int)Math.Ceiling(Model.Total/(double)Model.PageSize))</span>
 @if(Model.Page*Model.PageSize<Model.Total){<button data-field-page="@(Model.Page+1)">Next</button>}
 </nav>
</section>
