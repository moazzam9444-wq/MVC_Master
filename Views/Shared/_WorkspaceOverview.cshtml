@model WorkspaceOverview
<div class="workspace-overview" id="sqlOverview" data-role="@Model.Role">
 <header class="workspace-intro"><div><p class="workspace-eyebrow">@(Model.Role=="admin"?"PLATFORM CONTROL":Model.Role=="owner"?"VENUE OPERATIONS":"YOUR FOOTBALL WORKSPACE")</p><h2>@(Model.Role=="admin"?"Your platform at a glance":Model.Role=="owner"?"Your pitches, organised":"Your next match starts here")</h2><p>@(Model.Role=="admin"?"Review account access, reservations and sandbox payments.":Model.Role=="owner"?"Manage your venues, reservations and competitions in one place.":"Your reservations, team and upcoming football, together.")</p></div><div class="workspace-actions"><a class="dash-btn" href="@(Model.Role=="admin"?"#users":Model.Role=="owner"?"#fields":"/Pages/Fields/fields.html")">@(Model.Role=="admin"?"Review accounts":Model.Role=="owner"?"Manage fields":"Find a pitch") ↗</a><a class="dash-btn secondary" href="@(Model.Role=="admin"?"#revenue":"#messages")">@(Model.Role=="admin"?"Payment review":"Messages") ↗</a></div></header>
 <section class="stats-grid" aria-label="Workspace statistics">
 @foreach(var metric in Model.Metrics){<a class="stat-card statistic-link" href="@metric.Url"><span class="stat-top">@metric.Label</span><strong data-metric="@metric.Label">@metric.Value.ToString("N0")</strong><small>@metric.Note</small><span class="metric-arrow" aria-hidden="true">↗</span></a>}
 </section>
 <div class="phase8-overview-columns">
  <section class="dash-panel"><div class="panel-heading"><div><p class="workspace-eyebrow">RESERVATIONS</p><h2>Booking status</h2></div><a href="#bookings">View bookings ↗</a></div><ul class="phase8-status-list">
  @foreach(var status in Model.BookingStatuses){<li><span class="kx-status" data-status="@status.Label">@status.Label</span><strong>@status.Value.ToString("N0")</strong><progress value="@status.Value" max="@Math.Max(1,Model.BookingStatuses.Sum(s=>s.Value))" aria-label="@status.Label bookings">@status.Value</progress></li>}
  </ul><p class="phase8-footnote">All reservation history · dates shown in Amman (UTC+03:00).</p></section>
  <section class="dash-panel"><div class="panel-heading"><div><p class="workspace-eyebrow">NEXT ON THE PITCH</p><h2>Upcoming activity</h2></div></div>
  @if(Model.Activity.Count==0){<div class="phase8-empty"><span aria-hidden="true">◎</span><h3>Your next kick-off awaits</h3><p>@(Model.Role=="admin"?"Platform games and tournaments appear here once they are scheduled.":Model.Role=="owner"?"Your scheduled games and tournaments will appear here.":"Games and tournaments will appear here when you take part.")</p><a class="dash-btn secondary" href="/Pages/OpenGames/open-games.html">Explore Open Games ↗</a></div>}
  else{<ul class="phase8-activity-list">@foreach(var item in Model.Activity){<li><div class="phase8-date"><strong>@item.Date.ToOffset(TimeSpan.FromHours(3)).ToString("dd")</strong><span>@item.Date.ToOffset(TimeSpan.FromHours(3)).ToString("MMM")</span></div><div><a href="@item.Url">@item.Title ↗</a><small>@item.Detail · @item.Date.ToOffset(TimeSpan.FromHours(3)).ToString("HH:mm") Amman</small><span class="kx-status">@item.Status</span></div></li>}</ul>}
  </section>
 </div>
 @if(Model.Role=="player"){<section class="dash-panel phase8-team"><div><p class="workspace-eyebrow">YOUR SQUAD</p><h2>@(Model.TeamName??"Football is better together")</h2><p>@(Model.TeamName is null?"Create a team or find your place in a squad.":$"{Model.TeamRequests} pending team request(s). Manage your roster, requests and captaincy.")</p></div><div class="workspace-actions"><a class="dash-btn secondary" href="/Pages/Teams/teams.html">@(Model.TeamName is null?"Explore teams":"My team") ↗</a><a class="dash-btn secondary" href="/Pages/Challenges/challenges.html">Team challenges ↗</a></div></section>}
 <section class="dash-panel"><div class="panel-heading"><div><p class="workspace-eyebrow">RESERVATION HISTORY</p><h2>Recent bookings</h2></div><a href="#bookings">View all ↗</a></div>
 <div class="table-wrap"><table class="dashboard-table phase8-table" data-no-pagination><caption class="kx-sr-only">Five most recently created reservations</caption><thead><tr><th scope="col">Field</th><th scope="col">Reservation</th><th scope="col">Session · Amman</th><th scope="col">Status</th></tr></thead><tbody>
 @foreach(var row in Model.Bookings){<tr><td data-label="Field"><a class="table-primary" href="@row.Url">@row.Title ↗</a></td><td data-label="Reservation">@row.Detail</td><td data-label="Session · Amman">@row.Date.ToOffset(TimeSpan.FromHours(3)).ToString("dd MMM yyyy · HH:mm")</td><td data-label="Status"><span class="kx-status" data-status="@row.Status">@row.Status</span></td></tr>}
 @if(Model.Bookings.Count==0){<tr><td colspan="4"><div class="phase8-empty"><h3>No reservations yet</h3><p>Your booking history will appear here after your first reservation.</p></div></td></tr>}
 </tbody></table></div></section>
 <p class="phase8-footnote">Updated from SQL Server · Stripe TEST MODE ONLY · No automatic refunds, commissions or payouts.</p>
</div>
