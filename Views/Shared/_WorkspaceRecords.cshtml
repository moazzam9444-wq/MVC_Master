@model WorkspaceLedger
<section class="dash-panel" id="sqlWorkspaceRecords" data-kind="@Model.Kind">
 <div class="panel-heading"><div><p class="workspace-eyebrow">ADMINISTRATOR WORKSPACE</p><h2>@(Model.Kind=="feedback"?"Community feedback":Model.Kind=="fields"?"Field review":"Reservation history")</h2><p>@Model.Total.ToString("N0") record(s) · @(Model.Kind=="feedback"?"Submitted feedback is visible only to administrators.":Model.Kind=="fields"?"Read-only review of published, archived and unavailable fields. Owners manage their venues.":"Read-only platform review. Players and owners manage their own reservations.")</p></div></div>
 <form class="phase8-filter" data-workspace-filter><label>Search<input type="search" name="Search" maxlength="120" value="@ViewData["Search"]" placeholder="@(Model.Kind=="feedback"?"Name or message":Model.Kind=="fields"?"Field, city or owner":"Field, player or status")"></label><button class="dash-btn secondary">Search</button></form>
 <div class="table-wrap"><table class="dashboard-table phase8-table" data-no-pagination><thead><tr><th scope="col">@(Model.Kind=="feedback"?"Name":"Field")</th><th scope="col">Details</th><th scope="col">Date · Amman</th><th scope="col">@(Model.Kind=="feedback"?"Rating":"Status")</th></tr></thead><tbody>
 @foreach(var r in Model.Items){<tr><td data-label="@(Model.Kind=="feedback"?"Name":"Field")">@if(r.Url is not null){<a href="@r.Url">@r.Title ↗</a>}else{@r.Title}@if(r.Context is not null){<small>@r.Context</small>}</td><td data-label="Details" class="phase8-long-text">@r.Detail</td><td data-label="Date · Amman">@r.Date.ToOffset(TimeSpan.FromHours(3)).ToString("dd MMM yyyy · HH:mm")</td><td data-label="@(Model.Kind=="feedback"?"Rating":"Status")"><span class="kx-status" data-status="@r.Status">@r.Status</span></td></tr>}
 @if(Model.Total==0){<tr><td colspan="4"><div class="phase8-empty"><h3>No matching records</h3><p>Try another search or return when new activity is available.</p></div></td></tr>}
 </tbody></table></div><nav class="kicks-table-pagination" aria-label="Record pages">@if(Model.Page>1){<button data-workspace-page="@(Model.Page-1)">Previous</button>}<span>Page @Model.Page of @Math.Max(1,(Model.Total+19)/20)</span>@if(Model.Page*20<Model.Total){<button data-workspace-page="@(Model.Page+1)">Next</button>}</nav>
</section>
